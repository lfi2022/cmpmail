APP_HOST=0.0.0.0
APP_PORT=8000
PUBLIC_URL=https://mcp.lfinfo.be
MCP_PATH=/mcp
DATABASE_URL=sqlite+aiosqlite:///./data/mailmcp.db
SECRET_KEY=A_REMPLIR
ENCRYPTION_KEY=A_REMPLIR
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@lfinfo.be
ADMIN_PASSWORD_HASH=A_REMPLIR
MCP_AUTH_ENABLED=true
MCP_LEGACY_API_KEY_ENABLED=false
MCP_API_KEY=A_REMPLIR
OAUTH_ENABLED=true
OAUTH_ISSUER=https://mcp.lfinfo.be
OAUTH_RESOURCE=https://mcp.lfinfo.be/mcp
OAUTH_SIGNING_KEY_PATH=secrets/oauth-private.pem
OAUTH_SIGNING_PUBLIC_KEY_PATH=secrets/oauth-public.pem
OAUTH_SIGNING_KID=mailmcp-2026-01
OAUTH_ACCESS_TOKEN_MINUTES=15
OAUTH_REFRESH_TOKEN_DAYS=30
OAUTH_AUTHORIZATION_CODE_MINUTES=5
OAUTH_SESSION_HOURS=8
OAUTH_LOGIN_ATTEMPTS=5
OAUTH_LOGIN_LOCK_MINUTES=15
ALLOWED_HOSTS=localhost,127.0.0.1,mcp.lfinfo.be
ALLOWED_ORIGINS=https://mcp.lfinfo.be
TRUSTED_PROXIES=10.0.100.2
ATTACHMENT_DOWNLOAD_ENABLED=false
MAX_ATTACHMENT_SIZE_MB=25
ATTACHMENT_SAVE_DIR=data/attachments
BLOCKED_ATTACHMENT_TYPES=application/x-msdownload,application/x-dosexec
MAX_REQUEST_SIZE_MB=30
MAX_RAW_MESSAGE_SIZE_MB=10
READ_ONLY=false
ALLOW_COPY_IN_READ_ONLY=false
DESTRUCTIVE_OPERATIONS_ENABLED=true
FACEBOOK_GRAPH_API_VERSION=v19.0
FACEBOOK_USER_ACCESS_TOKEN=
# Facebook app credentials and page tokens are managed in the admin UI and stored in the database.
RATE_LIMIT_PER_MINUTE=120
MAIL_TIMEOUT_SECONDS=30
LOG_LEVEL=INFO
SECURE_COOKIES=true
FRONTEND_DIR=frontend/dist
